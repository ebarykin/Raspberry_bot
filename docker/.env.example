# Опционально на плате: cp docker/.env.example docker/.env
# jetson_docker.sh подключает его через --env-file docker/.env
# (обычный compose без --env-file читает только ./.env в корне clone).
# make capture-up без DOCKER_CONFIG: resolve читает CONFIG_HOST отсюда.
# Иначе make спросит конфиг в терминале.

# docker/.env в .gitignore — на плату не коммитится.

# JP 7.2 (робособаки). Роверы 6.2:
# CAPTURE_IMAGE=cr.selcloud.ru/sandbox/last-mile/drivers/capture-pipeline:latest
CAPTURE_IMAGE=cr.selcloud.ru/sandbox/last-mile/drivers/capture-pipeline-jp72:latest

# Стенд: jetson-duo-one-s.yaml. Роверы: jetson-delta.yaml.
CONFIG_HOST=./configs/jetson-duo-one-s.yaml

ROS_DOMAIN_ID=0
PULL_POLICY=always
