# x86-эмуляция videotestsrc. Образ Jetson (L4T/ROS) на VPS 224 не собирается.
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

RUN sed -i 's/^Components: main$/Components: main universe/' /etc/apt/sources.list.d/ubuntu.sources \
    && apt-get update && apt-get install -y --no-install-recommends \
      python3 \
      python3-gi \
      python3-pip \
      gir1.2-gstreamer-1.0 \
      gir1.2-gst-rtsp-server-1.0 \
      gstreamer1.0-tools \
      gstreamer1.0-plugins-base \
      gstreamer1.0-plugins-good \
      gstreamer1.0-plugins-bad \
      gstreamer1.0-plugins-ugly \
      gstreamer1.0-libav \
      gstreamer1.0-rtsp \
      libpango-1.0-0 \
      libpangocairo-1.0-0 \
      gstreamer1.0-x \
    && python3 -m pip install --break-system-packages --no-cache-dir \
         'numpy>=1.23,<2' 'PyYAML>=6' 'websockets>=12' \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY main.py ./
COPY capture_pipeline ./capture_pipeline
COPY configs ./configs

ENTRYPOINT ["python3", "-u", "/app/main.py"]
CMD ["--config", "configs/vps224-echd-lab.yaml"]
